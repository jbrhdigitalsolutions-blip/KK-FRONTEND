KK_FRONTEND_PORT=4317
KK_FRONTEND_DATA_DIR=
KK_FRONTEND_HEADLESS=false
# Optional external coding agent. Process is launched without a shell.
# KK_FRONTEND_AGENT_COMMAND=claude
# KK_FRONTEND_AGENT_ARGS_JSON=["-p","Read {taskFile} and implement it completely in {projectRoot}. Do not commit or push."]

# Web-only Reference → DESIGN.md cloud browser.
# Set either a Browserless token (default production endpoint) or a complete WebSocket endpoint.
# Never expose these values in browser-side code.
BROWSERLESS_TOKEN=
BROWSERLESS_WS_ENDPOINT=
# Local development only. Keep false/unset in production.
# KK_REFERENCE_ALLOW_PRIVATE=false
