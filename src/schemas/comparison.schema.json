{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KK-FRONTEND Comparison",
  "type": "object",
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "kk-frontend-comparison/v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "route",
          "category",
          "difference",
          "evidence"
        ]
      }
    }
  }
}